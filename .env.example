# Copy to .env and adjust. Used by docker-compose.yml. Never commit real secrets.
POSTGRES_USER=tribo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tribopredict
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional API key; when set, the backend requires X-API-Key and the frontend sends it
API_KEY=

# URL the browser uses to reach the backend
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

RANDOM_SEED=42
TRAINING_WORKERS=1
N_JOBS=2
