# ---- Backend (FastAPI) -------------------------------------------------------
# PostgreSQL (Docker Compose default). For a quick local run without Docker use SQLite:
#   DATABASE_URL=sqlite:///./storage/tribopredict.db
DATABASE_URL=sqlite:///./storage/tribopredict.db
STORAGE_DIR=./storage
BUNDLED_DATASET_DIR=../data/source/kolev_2023_pin_on_disk
# Optional: when set, every /api request must send the header X-API-Key
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RANDOM_SEED=42
TRAINING_WORKERS=1
N_JOBS=2
MAX_UPLOAD_MB=50
ENVIRONMENT=development
